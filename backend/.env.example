# Copia este archivo como .env (en esta misma carpeta backend/) y completa los valores.
# .env NUNCA se sube al repositorio.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (puerto 5432)
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Clave para firmar sesiones y tokens. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Firebase → Realtime Database (URL de la base, no es secreta)
FIREBASE_DB_URL=https://tu-proyecto-default-rtdb.firebaseio.com
# Firebase → Configuración del proyecto → Cuentas de servicio → Secretos de la base de datos
# Necesario para leer cuando las reglas están cerradas. NUNCA va en el sketch ni en la app.
FIREBASE_DB_SECRET=

# Google AI Studio (https://aistudio.google.com) → Get API key. Gratis mientras NO actives facturación.
# Sin clave, el análisis funciona igual con un texto automático.
GEMINI_API_KEY=
# Modelo de la familia Flash. Para ver los disponibles: python -m scripts.probar_gemini
GEMINI_MODELO=gemini-3.1-flash-lite
# Se prueban en orden si el principal está saturado o sin cuota (separados por comas)
GEMINI_MODELOS_RESPALDO=gemini-3.5-flash-lite,gemini-3.5-flash
